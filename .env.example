# Ictus Flow System Configuration
# Copy this file to: C:\Users\gk100\Ictus Flow Automation Secrets\.env
# Fill in your actual keys. NEVER commit the real .env to version control.

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
GOOGLE_SERVICE_ACCOUNT_JSON=C:\Users\gk100\Ictus Flow Automation Secrets\service-account.json
RESEND_API_KEY=re_your-key-here

# Model selection
MODEL_CLASSIFIER=claude-haiku-4-5-20251001
MODEL_STANDARD=claude-sonnet-4-5-20250929
MODEL_COMPLEX=claude-opus-4-6

# Polling interval (seconds)
# 300 = 5 min. Consider Google Drive push notifications (webhooks) for real-time as a future upgrade.
DRIVE_POLL_INTERVAL=300
